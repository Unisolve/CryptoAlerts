# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# CoinGecko Demo API key (optional — raises rate limits; keyless works for this low volume)
COINGECKO_API_KEY=

# SMTP relay — Zoho AU (proven working from staging on port 587/STARTTLS)
SMTP_HOST=smtp.zoho.com.au
SMTP_PORT=587
SMTP_USER=simon@unisolve.com.au
SMTP_PASS=

# Email envelope
ALERT_FROM=Crypto Pulse <simon@unisolve.com.au>
ALERT_TO=simon@unisolve.com.au
